import cv2
import torch
import numpy as np
import yaml

from pathlib import Path
from types import SimpleNamespace
from ultralytics import YOLO
from ultralytics.utils.nms import non_max_suppression
from ultralytics.engine.results import Boxes
from ultralytics.trackers.byte_tracker import BYTETracker


# =====================================
# 基本設定
# =====================================

torch.set_num_threads(1)

MODEL_SIZE = 320
CONF_THRESHOLD = 0.25
IOU_THRESHOLD = 0.45
PANEL_WIDTH = 320

# =====================================
# YOLOモデル
# =====================================

model = YOLO("yolo11n.pt")
model.model.eval()

# =====================================
# ByteTrack設定
# =====================================

tracker_path = (
    Path(__import__("ultralytics").__file__).parent
    / "cfg/trackers/bytetrack.yaml"
)

with open(tracker_path, encoding="utf-8") as f:
    tracker_args = SimpleNamespace(**yaml.safe_load(f))

tracker = BYTETracker(tracker_args)

# =====================================
# カメラ設定
# =====================================

cap = cv2.VideoCapture(0, cv2.CAP_V4L2)

if not cap.isOpened():
    print("カメラを開けません")
    raise SystemExit(1)

cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

# =====================================
# 人数管理（RAMのみ）
# =====================================

seen_track_ids = set()

print("人物カウント開始。終了は q キー")
print("画像・動画・人数データは保存しません")

# =====================================
# メイン処理
# =====================================

try:
    while True:

        ret, frame = cap.read()

        if not ret:
            print("カメラ画像を取得できません")
            break

        h, w = frame.shape[:2]

        # ---------------------------------
        # 画像前処理
        # ---------------------------------

        scale = min(
            MODEL_SIZE / w,
            MODEL_SIZE / h
        )

        new_w = int(w * scale)
        new_h = int(h * scale)

        resized = cv2.resize(frame, (new_w, new_h))

        padded = np.full(
            (MODEL_SIZE, MODEL_SIZE, 3),
            114,
            dtype=np.uint8
        )

        pad_x = (MODEL_SIZE - new_w) // 2
        pad_y = (MODEL_SIZE - new_h) // 2

        padded[
            pad_y:pad_y + new_h,
            pad_x:pad_x + new_w
        ] = resized

        image = cv2.cvtColor(
            padded,
            cv2.COLOR_BGR2RGB
        )

        image = image.transpose(2, 0, 1)
        image = np.ascontiguousarray(image)

        tensor = torch.from_numpy(image)
        tensor = tensor.unsqueeze(0).float() / 255.0

        # ---------------------------------
        # YOLO推論
        # ---------------------------------

        with torch.no_grad():
            output = model.model(tensor)

        prediction = (
            output[0]
            if isinstance(output, tuple)
            else output
        )

        results = non_max_suppression(
            prediction,
            conf_thres=CONF_THRESHOLD,
            iou_thres=IOU_THRESHOLD,
            nc=80
        )

        detections = results[0]

        # ---------------------------------
        # 検出座標を元画像に戻す
        # ---------------------------------

        person_detections = []

        if detections is not None and len(detections) > 0:

            detections = detections.cpu().numpy()

            for detection in detections:

                x1, y1, x2, y2, confidence, cls = detection

                # 人物クラスのみ
                if int(cls) != 0:
                    continue

                x1 = (x1 - pad_x) / scale
                y1 = (y1 - pad_y) / scale
                x2 = (x2 - pad_x) / scale
                y2 = (y2 - pad_y) / scale

                x1 = np.clip(x1, 0, w)
                y1 = np.clip(y1, 0, h)
                x2 = np.clip(x2, 0, w)
                y2 = np.clip(y2, 0, h)

                person_detections.append([
                    x1, y1, x2, y2,
                    confidence, cls
                ])

        # ---------------------------------
        # ByteTrack追跡
        # ---------------------------------

        if person_detections:
            detection_array = np.array(
                person_detections,
                dtype=np.float32
            )
        else:
            detection_array = np.empty(
                (0, 6),
                dtype=np.float32
            )

        boxes = Boxes(detection_array, (h, w))
        tracks = tracker.update(boxes)

        # ---------------------------------
        # 人数カウント
        # ---------------------------------

        current_count = len(tracks)

        for track in tracks:

            x1, y1, x2, y2 = map(int, track[:4])

            track_id = int(track[4])
            confidence = float(track[5])

            # 新しい追跡IDを累計
            seen_track_ids.add(track_id)

            # 人物枠
            cv2.rectangle(
                frame,
                (x1, y1),
                (x2, y2),
                (0, 255, 0),
                2
            )

            # 追跡ID
            cv2.putText(
                frame,
                f"ID: {track_id} {confidence:.2f}",
                (x1, max(20, y1 - 10)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2
            )

        total_count = len(seen_track_ids)

        # ---------------------------------
        # 左右画面の合成
        # ---------------------------------

        display = np.zeros(
            (h, w + PANEL_WIDTH, 3),
            dtype=np.uint8
        )

        # 左側：カメラ映像
        display[:, :w] = frame

        # 右側：情報パネル
        panel = display[:, w:]
        panel[:] = (35, 35, 35)

        # ヘッダー
        cv2.rectangle(
            panel,
            (0, 0),
            (PANEL_WIDTH, 65),
            (50, 50, 50),
            -1
        )

        cv2.putText(
            panel,
            "PEOPLE COUNTER",
            (20, 40),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.75,
            (255, 255, 255),
            2
        )

        # 稼働表示
        cv2.circle(
            panel,
            (27, 100),
            7,
            (0, 220, 0),
            -1
        )

        cv2.putText(
            panel,
            "LIVE",
            (45, 107),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.65,
            (0, 220, 0),
            2
        )

        # 現在の人数
        cv2.putText(
            panel,
            "CURRENT PEOPLE",
            (20, 175),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.65,
            (200, 200, 200),
            1
        )

        cv2.putText(
            panel,
            str(current_count),
            (20, 245),
            cv2.FONT_HERSHEY_SIMPLEX,
            2.5,
            (0, 255, 255),
            4
        )

        # 区切り線
        cv2.line(
            panel,
            (20, 280),
            (PANEL_WIDTH - 20, 280),
            (90, 90, 90),
            1
        )

        # 総人数
        cv2.putText(
            panel,
            "TOTAL PEOPLE",
            (20, 335),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.65,
            (200, 200, 200),
            1
        )

        cv2.putText(
            panel,
            str(total_count),
            (20, 405),
            cv2.FONT_HERSHEY_SIMPLEX,
            2.5,
            (0, 200, 255),
            4
        )

        # 録画しないことを表示
        cv2.putText(
            panel,
            "NO IMAGE / VIDEO RECORDING",
            (20, 455),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.42,
            (180, 180, 180),
            1
        )

        # ---------------------------------
        # 画面表示
        # ---------------------------------

        cv2.imshow("People Counter", display)

        if cv2.waitKey(1) & 0xFF == ord("q"):
            break

finally:

    cap.release()
    cv2.destroyAllWindows()

    print("人物カウントを終了しました")
    print("RAM上の人数情報を破棄しました")
